from collections import defaultdict
from math import gcd

def max_collinear_points(X, Y):
    n = len(X)
    
    if n <= 2:
        return n

    ans = 0

    for i in range(n):
        slopes = defaultdict(int)
        duplicates = 1   # count the point itself

        x1, y1 = X[i], Y[i]

        for j in range(i + 1, n):
            x2, y2 = X[j], Y[j]

            dx = x2 - x1
            dy = y2 - y1

            # Duplicate point
            if dx == 0 and dy == 0:
                duplicates += 1
                continue

            # Normalize slope using gcd
            g = gcd(dx, dy)
            dx //= g
            dy //= g

            # Keep a unique representation
            if dx < 0:
                dx = -dx
                dy = -dy
            elif dx == 0:
                dy = 1      # vertical line
            elif dy == 0:
                dx = 1      # horizontal line

            slopes[(dy, dx)] += 1

        max_on_line = 0
        for count in slopes.values():
            max_on_line = max(max_on_line, count)

        ans = max(ans, duplicates + max_on_line)

    return ans


# Example 1
X = [0, 1, 2]
Y = [0, 1, 2]
print(max_collinear_points(X, Y))   # 3

