LEETCODE 718 variation 
PROBLEM STATEMENT :

Given two arrays A and B, return the length of the longest common contiguous subarray if you are allowed to ignore (or replace) at most one non-matching element.


PYTHON IMPLEMENTATION:


def max_length_repeated_subarray_with_1_replacement(A: list[int], B: list[int]) -> int:
    n, m = len(A), len(B)
    
    # dp0 tracks 0 replacements, dp1 tracks exactly 1 replacement
    dp0 = [0] * (m + 1)
    dp1 = [0] * (m + 1)
    max_len = 0
    
    for i in range(1, n + 1):
        # Temp arrays to store the results for the current row
        next_dp0 = [0] * (m + 1)
        next_dp1 = [0] * (m + 1)
        
        for j in range(1, m + 1):
            if A[i - 1] == B[j - 1]:
                # If numbers match, both streaks just extend by 1
                next_dp0[j] = dp0[j - 1] + 1
                next_dp1[j] = dp1[j - 1] + 1
            else:
                # If numbers mismatch, the 0-replacement streak breaks completely
                next_dp0[j] = 0
                # The 1-replacement streak consumes its replacement right here
                next_dp1[j] = dp0[j - 1] + 1
                
            # Track the global longest common subarray found so far
            max_len = max(max_len, next_dp0[j], next_dp1[j])
            
        # Move to the next row
        dp0 = next_dp0
        dp1 = next_dp1
        
    return max_len


dp0[i][j] = length of the longest common subarray ending at A[i-1] and B[j-1] with 0 mismatches used.

dp1[i][j] = length of the longest common subarray ending at A[i-1] and B[j-1] with at most 1 mismatch used.

